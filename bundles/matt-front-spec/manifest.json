{
  "formatVersion": 1,
  "bundle": {
    "id": "dev.secant.matt-front",
    "version": "1.1.0",
    "name": "Matt Front Spec",
    "description": "Interview the human to shape a feature, let them choose the tracker, then write the spec in the same Session."
  },
  "platforms": ["windows", "macos", "linux"],
  "inputs": {},
  "assets": [
    {
      "path": "prompts/grill.md",
      "kind": "prompt"
    },
    {
      "path": "prompts/spec.md",
      "kind": "prompt"
    },
    {
      "path": "skills/grilling",
      "kind": "skill"
    },
    {
      "path": "skills/spec-writing",
      "kind": "skill"
    }
  ],
  "routing": [
    {
      "id": "grill",
      "kind": "interactive-agent",
      "session": "spec",
      "prompt": {
        "asset": "prompts/grill.md"
      },
      "uses": [
        {
          "asset": "skills/grilling"
        }
      ]
    },
    {
      "id": "choose-tracker",
      "kind": "human-gate",
      "shape": "free-text",
      "message": "The interview is complete. Where should the spec and tickets live? Choose Local or GitHub, or type another tracker your agent can reach.",
      "suggestions": ["Local", "GitHub"],
      "produces": [
        {
          "name": "tracker",
          "type": "text"
        }
      ]
    },
    {
      "id": "write-spec",
      "kind": "agent",
      "session": "spec",
      "requires": ["tracker"],
      "prompt": {
        "asset": "prompts/spec.md"
      },
      "uses": [
        {
          "asset": "skills/spec-writing"
        }
      ]
    }
  ]
}
