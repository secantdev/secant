{
  "name": "@secantdev/secant",
  "version": "0.1.0",
  "author": "secantdev",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "assemble": "bun run scripts/assemble.ts",
    "build": "bun run scripts/build.ts",
    "check": "bun run migrations:check && bun run typecheck && bun run format:check && bun run lint && bun run test && bun run build && bun run test:package",
    "check:claude-code": "bun scripts/release-checks/installed-harness.ts claude-code",
    "check:codex": "bun scripts/release-checks/installed-harness.ts codex",
    "check:windows-terminal": "bun scripts/release-checks/windows-terminal.ts",
    "dev": "bun src/cli/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrations:check": "bun scripts/check-migrations.ts",
    "migrations:generate": "bun drizzle-kit generate --config drizzle.catalog.config.ts && bun drizzle-kit generate --config drizzle.coordination.config.ts && bun drizzle-kit generate --config drizzle.run.config.ts",
    "test": "bun run scripts/test.ts",
    "test:package": "bun scripts/package-smoke.ts",
    "test:terminal": "bun tests/terminal/lifecycle.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/semver": "7.7.1",
    "@types/which": "3.0.4",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "description": "Secant reaches an outcome by routing between Steps. In-development; nothing is published yet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secantdev/secant.git"
  },
  "homepage": "https://github.com/secantdev/secant#readme",
  "bugs": {
    "url": "https://github.com/secantdev/secant/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "orchestrator",
    "devtools"
  ],
  "contributors": [
    "Rohan Garg <gargrohan831@gmail.com> (https://rgdev.xyz)"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "commander": "14.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "semver": "7.7.4",
    "solid-js": "1.9.12",
    "string-width": "7.2.0",
    "strip-ansi": "7.1.2",
    "which": "6.0.1",
    "zod": "4.1.8"
  }
}
