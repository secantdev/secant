{
  "name": "@secantdev/secant",
  "version": "0.1.0",
  "author": "secantdev",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run typecheck && bun run format:check && bun run lint && bun run test && bun run build && bun run test:package",
    "check:windows-terminal": "bun scripts/release-checks/windows-terminal.ts",
    "dev": "bun src/cli/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun test --timeout 30000",
    "test:package": "bun scripts/package-smoke.mjs",
    "test:terminal": "bun tests/terminal/lifecycle.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/semver": "7.7.1",
    "@types/which": "3.0.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "description": "Secant reaches an outcome by routing between Steps. In-development; nothing is published yet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secantdev/secant.git"
  },
  "homepage": "https://github.com/secantdev/secant#readme",
  "bugs": {
    "url": "https://github.com/secantdev/secant/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "orchestrator",
    "devtools"
  ],
  "contributors": [
    "Rohan Garg <gargrohan831@gmail.com> (https://rgdev.xyz)"
  ],
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "commander": "14.0.2",
    "semver": "7.7.4",
    "solid-js": "1.9.12",
    "which": "2.0.2",
    "zod": "4.1.8"
  }
}
